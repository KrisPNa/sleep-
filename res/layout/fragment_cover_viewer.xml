<?xml version="1.0" encoding="utf-8"?>
<com.example.seriestracker.ui.custom.SwipeToDismissLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeDismissLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.example.seriestracker.ui.custom.ZoomPanLayout
        android:id="@+id/coverZoomLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/coverImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cover_image"
            android:scaleType="fitCenter" />

    </com.example.seriestracker.ui.custom.ZoomPanLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@drawable/gradient_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_search"
            android:src="@drawable/ic_baseline_close_24" />

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="Обложка" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/resetZoomButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_background_video"
            android:contentDescription="@string/reset_zoom"
            android:src="@drawable/ic_baseline_fit_screen_24"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</com.example.seriestracker.ui.custom.SwipeToDismissLayout>
