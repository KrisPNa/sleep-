<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.screens.MainScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Заголовок с иконкой поиска -->
        <FrameLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Нет, лакорн смотреть"
                android:textColor="@color/primary_blue"
                android:textSize="28sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        <!-- Поле поиска поверх текста (изначально скрыто) -->
        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/search_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            android:elevation="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_baseline_search_24"
                android:tint="@color/text_gray"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/contextualSearchEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Поиск коллекций и сериалов..."
                android:textSize="14sp"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:saveEnabled="false"
                android:background="@android:color/transparent"
                android:padding="0dp" />

            <ImageView
                android:id="@+id/closeSearchButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_search"
                android:src="@drawable/ic_baseline_close_24"
                android:tint="@color/text_gray" />

        </LinearLayout>

        <!-- Иконка поиска справа -->
            <ImageButton
                android:id="@+id/searchButton"
                android:layout_width="46dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:paddingTop="7dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Поиск"
                android:src="@drawable/ic_baseline_search_24"
                android:tint="@color/primary_blue" />
        </FrameLayout>

        <!-- Tabs for switching between collections and series (видимые только когда нет результатов поиска) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:tabIndicatorColor="@color/primary_blue"
            app:tabSelectedTextColor="@color/primary_blue"
            app:tabTextColor="@color/text_gray">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Коллекции" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сериалы" />

        </com.google.android.material.tabs.TabLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ViewPager2 for swipe functionality -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Результаты поиска (изначально скрыты) -->
            <FrameLayout
                android:id="@+id/searchResultsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:background="?android:attr/colorBackground">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/searchResultsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="16dp" />

                <TextView
                    android:id="@+id/noSearchResultsText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="32dp"
                    android:text="Ничего не найдено"
                    android:textColor="@color/text_gray"
                    android:textSize="16sp"
                    android:visibility="gone" />

            </FrameLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- Красивый блок с кнопками (поверх всего) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/buttonsCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="80dp"
    android:visibility="gone"
    android:alpha="0"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/background_white"
    android:layout_gravity="top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Первая строка кнопок -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/createCollectionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Создать\nколлекцию"
                android:textSize="14sp"
                android:minHeight="56dp"
                android:backgroundTint="@color/primary_blue"
                android:textColor="@color/white"
                android:drawableTop="@drawable/ic_baseline_add_24"
                android:drawablePadding="4dp"
                android:gravity="center"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/addSeriesButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Добавить\nсериал"
                android:textSize="14sp"
                android:minHeight="56dp"
                android:backgroundTint="@color/primary_blue"
                android:textColor="@color/white"
                android:drawableTop="@drawable/ic_baseline_queue_24"
                android:drawablePadding="4dp"
                android:gravity="center"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

    <!-- Затемнение фона при открытых кнопках -->
    <View
        android:id="@+id/overlayBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:alpha="0"
        android:clickable="true" />

    <!-- Шестерёнка поверх поиска — вместе с «добавить сериал/коллекцию» -->
    <ImageButton
        android:id="@+id/settingsGearButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/settings_gear_bg"
        android:contentDescription="Настройки"
        android:src="@drawable/ic_baseline_settings_24"
        android:tint="@color/white"
        android:padding="10dp"
        android:elevation="16dp"
        android:visibility="gone"
        android:alpha="0" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>