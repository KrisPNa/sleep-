<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editSeriesScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="80dp"
    tools:context=".ui.screens.EditSeriesScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Обложка + размытие до кнопки «Воспроизвести» включительно -->
        <FrameLayout
            android:id="@+id/coverStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@color/background_white">

            <ImageView
                android:id="@+id/coverBlurBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/cover_blur_white_fade" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Кнопки поверх обложки -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="8dp"
                    android:minHeight="48dp">

                    <ImageButton
                        android:id="@+id/backButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_baseline_arrow_back_24"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Кнопка назад" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/editButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_baseline_edit_24"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Редактировать" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="176dp"
                    android:layout_height="236dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="10dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/seriesImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/darker_gray"
                        android:clickable="true"
                        android:contentDescription="@string/cover_image"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <Button
                        android:id="@+id/selectImageButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/primary_blue_light"
                        android:minHeight="48dp"
                        android:text="Выбрать изображение"
                        android:textColor="@color/white" />

                    <ImageButton
                        android:id="@+id/deleteCoverButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/delete_cover"
                        android:src="@drawable/ic_baseline_delete_24"
                        android:tint="@android:color/holo_red_dark"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

                <!-- Название -->
                <EditText
                    android:id="@+id/titleEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@android:color/transparent"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_hint"
                    android:hint="Название сериала *"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:minHeight="48dp"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:longClickable="true" />

                <!-- Статус и Избранное -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/statusSpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_status_outline"
                        android:textSize="14sp"
                        android:textColor="#7A86A8"
                        android:minWidth="140dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:drawableStart="@drawable/ic_baseline_keyboard_arrow_down_24"
                        android:drawablePadding="2dp"
                        android:drawableTint="#7A86A8"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:cursorVisible="false" />

                    <ImageButton
                        android:id="@+id/favoriteButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_favorite_outline"
                        android:contentDescription="Избранное"
                        android:padding="7dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_bookmark_favorite_24"
                        android:tint="#9AA3B5" />

                </LinearLayout>

                <!-- Воспроизвести + лупа -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playWatchButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="Воспроизвести"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_baseline_play_arrow_24"
                        app:iconGravity="textStart"
                        app:cornerRadius="14dp" />

                    <ImageButton
                        android:id="@+id/searchWatchAtButton"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/search_watch_links"
                        android:src="@drawable/ic_baseline_search_24"
                        android:tint="@color/primary_blue"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

        <!-- Коллекции -->
        <TextView
            android:id="@+id/collectionsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Коллекции:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/collectionsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выбрать коллекции"
            android:textSize="14sp"
            android:minHeight="48dp"
            android:backgroundTint="@color/primary_blue_light"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/selectedCollectionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Не выбрано"
            android:textSize="14sp"
            android:textColor="@color/text_gray"
            android:padding="8dp"
            android:layout_marginBottom="12dp" />

        <!-- Ссылки для воспроизведения хранятся скрыто; правятся через 🔍 у кнопки Воспроизвести -->
        <EditText
            android:id="@+id/watchAtEditText"
            style="@style/Widget.App.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:inputType="textCapSentences|textMultiLine" />

        <TextView
            android:id="@+id/watchAtLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/watchAtEditContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/watchAtTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Ссылки -->
        <TextView
            android:id="@+id/watchUrlLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ссылки:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/watchUrlEditText"
            style="@style/Widget.App.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ссылки"
            android:inputType="textUri|textMultiLine"
            android:imeOptions="actionNext"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/watchUrlTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ссылки"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp"
            android:textColorLink="@color/primary_blue"
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:autoLink="none" />

        <!-- Дополнительная информация -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Дополнительная информация:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/genreEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_hint"
            android:hint="Жанр"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/seasonsEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_hint"
                android:hint="Сезоны"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/episodesEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_hint"
                android:hint="Эпизоды"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:minHeight="48dp" />

        </LinearLayout>

        <!-- Заметки -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Заметки:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/notesEditText"
            style="@style/Widget.App.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Заметки"
            android:inputType="textMultiLine"
            android:imeOptions="actionNext"
            android:minLines="3"
            android:minHeight="120dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Заметки"
            android:minLines="3"
            android:minHeight="120dp"
            android:layout_marginBottom="16dp"
            android:textColorLink="@color/primary_blue"
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:autoLink="none" />

        <!-- Медиафайлы -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Медиафайлы:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/addMediaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить фото/видео"
            android:textSize="14sp"
            android:minHeight="48dp"
            android:backgroundTint="@color/primary_blue_light"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mediaRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить"
            android:textSize="16sp"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Удалить сериал"
            android:textSize="16sp"
            android:minHeight="48dp"
            android:backgroundTint="@android:color/holo_red_dark"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
