<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"

    android:layout_height="match_parent"

    android:fillViewport="true"

    android:padding="24dp">



    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:gravity="center_horizontal">



        <TextView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:text="Series Tracker"

            android:textSize="32sp"

            android:textStyle="bold"

            android:gravity="center"

            android:layout_marginTop="48dp"

            android:layout_marginBottom="8dp" />



        <TextView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:text="Войди тем же аккаунтом, что и на сайте — данные синхронизируются."

            android:textSize="14sp"

            android:gravity="center"

            android:layout_marginBottom="32dp" />



        <EditText

            android:id="@+id/authEmail"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:hint="Email"

            android:inputType="textEmailAddress"

            android:layout_marginBottom="12dp" />



        <com.google.android.material.textfield.TextInputLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginBottom="8dp"

            android:hint="Пароль"

            app:endIconMode="password_toggle">



            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/authPassword"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:inputType="textPassword" />

        </com.google.android.material.textfield.TextInputLayout>



        <Button

            android:id="@+id/authResetBtn"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_gravity="end"

            android:layout_marginBottom="16dp"

            android:text="Забыли пароль?"

            style="?android:attr/borderlessButtonStyle" />



        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:orientation="horizontal">



            <Button

                android:id="@+id/authSignInBtn"

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Войти" />



            <Button

                android:id="@+id/authSignUpBtn"

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:layout_marginStart="8dp"

                android:text="Регистрация" />

        </LinearLayout>



        <TextView

            android:id="@+id/authError"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:textColor="#B00020"

            android:layout_marginTop="12dp" />



        <ProgressBar

            android:id="@+id/authProgress"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:visibility="gone" />



        <Button

            android:id="@+id/authSkipBtn"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:text="Продолжить без облака"

            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

</ScrollView>

